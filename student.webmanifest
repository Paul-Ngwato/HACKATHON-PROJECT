{
  "id": "/student.html",
  "name": "AttendSmart Student",
  "short_name": "AttendSmart",
  "description": "Check in to Baraton University classes with Bluetooth proximity. Works offline.",
  "start_url": "./student.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "assets/icons/student-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/student-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/student-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Check in", "short_name": "Check in", "url": "./student.html#/student/checkin" },
    { "name": "History", "short_name": "History", "url": "./student.html#/student/history" }
  ]
}
